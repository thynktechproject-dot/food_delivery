# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/food_delivery
DB_USERNAME=postgres
DB_PASSWORD=root

# JWT Configuration
JWT_SECRET=mySuperSecureSecretKeyThatIsAtLeast32BytesLong123
JWT_ISSUER=food-delivery-app
JWT_EXPIRATION_MILLIS=3600000
JWT_REFRESH_EXPIRATION_MILLIS=1209600000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional Bootstrap Admin (set to true to create on startup)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional Swagger (set to true to enable API docs)
SWAGGER_ENABLED=true